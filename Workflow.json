      "parameters": {
        "jsCode": "// === Obtener datos con los nombres EXACTOS del Form Trigger ===\nconst inputData = $input.first().json;\n\n// 🔑 Nombres de campo según tu formulario en español\nconst plan = inputData['Elige tu plan'];\nconst email = $input.first().json.body.Email;\nconst nombre = $input.first().json.body['Nombre de usuario'];\n\n// Debug opcional: descomenta para ver en consola qué llega\n// console.log('Plan raw:', planRaw, 'Email:', email, 'Nombre:', nombre);\n\n// Normalización: minúsculas + trim para comparar seguro\nconst planNormalized = String(plan || '').trim().toLowerCase();\n\nconst config = {\n  'base':   { prefix: 'BASE', days: 30, display: 'Base' },\n  'extra':  { prefix: 'EXTA', days: 90, display: 'Extra' },\n  'deluxe': { prefix: 'DLX',  days: 365, display: 'Deluxe' }\n};\n\n// Lookup con fallback a Base\nconst selected = config[planNormalized] || config['base'];\n\n// Generar UUID único\nconst uuid = 'xxxxxxxx'.replace(/x/g, () =>\n  Math.floor(Math.random() * 16).toString(16)\n).toUpperCase();\n\nconst license = `LIC-${selected.prefix}-${uuid}`;\n\n// Calcular fecha de renovación\nconst today = new Date();\nconst renew = new Date(today);\nrenew.setDate(today.getDate() + selected.days);\n\nconsole.log(typeof(email));\n\n// === OUTPUT ===\nreturn [{\n  json: {\n    correo: email,\n    name: nombre,\n    plan: selected.display,           // \"Deluxe\" (formato legible)\n    license_key: license,             // Ej: LIC-DLX-A3F9D2E1\n    status: 'active',\n    next_renewal: renew.toISOString().split('T')[0],\n    days_valid: selected.days\n  }\n}];"
      },
