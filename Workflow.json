    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst formatDate = (dateStr) => {\n  if (!dateStr) return 'N/A';\n  const d = new Date(dateStr);\n  return d.toLocaleDateString('es-CO', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric'\n  });\n};\n\nconst today = new Date();\nconst fechaFin = item.fecha_fin ? new Date(item.fecha_fin) : null;\nconst diasRestantes = fechaFin\n  ? Math.ceil((fechaFin - today) / (1000 * 60 * 60 * 24))\n  : null;\n\nconst estadoEmoji = item.estado === 'activa' ? '✅' : '⚠️';\n\nconst mensaje =\n  `📋 *Detalle de tu suscripción*\\n\\n` +\n  `📧 Email: ${item.email}\\n` +\n  `📦 Plan: *${item.plan || 'N/A'}*\\n` +\n  `📅 Inicio: ${formatDate(item.fecha_inicio)}\\n` +\n  `📅 Vencimiento: ${formatDate(item.fecha_fin)}\\n` +\n  `${estadoEmoji} Estado: *${item.estado || 'desconocido'}*\\n` +\n  (diasRestantes !== null\n    ? `⏳ Días restantes: *${diasRestantes}*\\n`\n    : '') +\n  `\\n¿Deseas activar un recordatorio de renovación?\\n` +\n  `Responde *SI* o *NO*`;\n\n// Calcular fecha exacta para el recordatorio (7 días antes del vencimiento)\nconst fechaRecordatorio = fechaFin \n  ? new Date(fechaFin.getTime() - (7 * 24 * 60 * 60 * 1000)) \n  : null;\n\nreturn {\n  ...item,\n  mensaje_estado: mensaje,\n  dias_restantes: diasRestantes,\n  fecha_recordatorio: fechaRecordatorio ? fechaRecordatorio.toISOString().split('T')[0] : null\n};"
      },
